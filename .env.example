# 이 파일을 복사해 .env 로 만들고 값을 채운 뒤 `docker compose up --build`
#   cp .env.example .env
# 아무것도 안 바꿔도 로컬(localhost)에서는 그대로 동작한다.

# ── 브라우저가 붙는 LiveKit 주소 ─────────────────────
# 로컬(SSH터널):  ws://localhost:7880
# EC2 IP 직접   :  ws://<EC2 공인 IP>:7880
# 도메인+HTTPS  :  wss://<도메인>       ← 뒤에 /rtc 를 붙이지 않는다!
#   (livekit-client 가 URL 에 /rtc 를 자동으로 붙인다. wss://도메인/rtc 로 주면
#    /rtc/rtc 가 되어 404 난다. nginx/caddy 가 /rtc 를 livekit 으로 프록시)
LIVEKIT_WS_URL=ws://localhost:7880

# ── (선택) 도메인 HTTPS 접속 — caddy 프로필 사용 시에만 ──
# 여러 명이 인터넷에서 https 로 접속할 때만 채운다.
#   1) DNS A레코드로 도메인 → EC2 공인 IP 연결
#   2) 보안그룹 80, 443 개방
#   3) 아래 DOMAIN/ACME_EMAIL 채우고 LIVEKIT_WS_URL 을 wss://<도메인> 로 변경 (/rtc 안 붙임)
#   4) docker compose --profile proxy up -d
# DOMAIN=foodshare.click
# ACME_EMAIL=you@example.com

# ── LiveKit API 키 (livekit.yaml / egress.yaml 의 값과 일치해야 함) ──
# 데모 기본값. 운영에선 반드시 교체하고 세 파일을 함께 바꾼다.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecret

# ── 녹음 저장: 우리 AWS S3 (Egress 가 직접 업로드) ──────────────────
# IAM 사용자 키(그 버킷에 s3:PutObject / GetObject / ListBucket 권한). SQS 를 쓸 거면
# 같은 IAM 사용자에 SQS 권한을 얹으면 된다(키 하나로 S3+SQS).
AWS_S3_BUCKET=projectree-recordings
AWS_S3_REGION=ap-northeast-2
AWS_S3_ACCESS_KEY=your-iam-access-key
AWS_S3_SECRET_KEY=your-iam-secret-key

# 녹음 후처리 큐 — egress_ended 시 백엔드가 이 큐로 발행(S3→SQS→워커). 리전/키는 위 S3 값 재사용.
# 비워두면 발행 생략(로컬/개발). IAM 사용자에 sqs:SendMessage 권한 필요.
# 단체(MIXED) 믹스 녹음 후처리 큐.
AWS_SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/<계정ID>/<큐이름>
# 개인(PARTICIPANT) 음성 후처리 큐. 메시지 내용은 단체와 같고 개인 음성 저장 경로(objectKey)를 담는다.
# 비워두면 개인 녹음도 위 단체 큐로 발행한다(하위 호환).
AWS_SQS_PERSONAL_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/110911131538/MyOpenViduQueue-Personal

# ── 세션 공유: 모놀리식과 같은 Upstash Redis (02 §7) ──────────────
# 회의 서비스가 이 Redis 세션에서 로그인 회원(LoginMember)을 읽는다.
# 모놀리식이 쓰는 Upstash 접속 정보와 동일하게 채운다. (없으면 세션 인증 기동 실패)
UPSTASH_REDIS_HOST=your-xxxx.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=your-upstash-password
UPSTASH_REDIS_SSL=true
