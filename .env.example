# 이 파일을 복사해 .env 로 만들고 값을 채운 뒤 `docker compose up --build`
#   cp .env.example .env
# 아무것도 안 바꿔도 로컬(localhost)에서는 그대로 동작한다.

# ── 브라우저가 붙는 LiveKit 주소 ─────────────────────
# 로컬:  ws://localhost:7880
# EC2 :  ws://<EC2 공인 IP 또는 도메인>:7880   ← 배포 시 반드시 변경
LIVEKIT_WS_URL=ws://localhost:7880

# ── LiveKit API 키 (livekit.yaml / egress.yaml 의 값과 일치해야 함) ──
# 데모 기본값. 운영에선 반드시 교체하고 세 파일을 함께 바꾼다.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecret

# ── MinIO(스크래치 저장소) ──────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=recordings
